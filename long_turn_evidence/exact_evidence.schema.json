{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"array",
  "items":{
    "type":"object",
    "required":["evidence_id","invocation_id","automation_id","source","supersedes_observation_invocation_id","start","end"],
    "properties":{
      "evidence_id":{"type":"string","minLength":1},
      "invocation_id":{"type":"string","minLength":1},
      "automation_id":{"type":"string","minLength":1},
      "source":{"const":"raw_github_start_end"},
      "supersedes_observation_invocation_id":{"type":"string","minLength":1},
      "start":{"$ref":"#/$defs/marker"},
      "end":{"$ref":"#/$defs/marker"}
    },
    "additionalProperties":false
  },
  "$defs":{"marker":{"type":"object","required":["id","created_at"],"properties":{"id":{"type":"integer","minimum":1},"created_at":{"type":"string","format":"date-time"}},"additionalProperties":false}}
}
